<mxfile host="app.diagrams.net" modified="2026-09-14T00:00:00.000Z" agent="Kiro" version="26.0.14" type="device"><diagram id="flujo-por-pestana-mv26020" name="Flujo por pestaña y persistencia"><mxGraphModel dx="2200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;MV26020 — Flujo objetivo por pestaña, persistencia y ejecución Softland&lt;/b&gt;&lt;br&gt;La base productiva solo cambia después de una aprobación válida" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1B365D;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="1640" height="50" as="geometry"/></mxCell><mxCell id="operator" value="&lt;b&gt;Operador / Solicitante&lt;/b&gt;&lt;br&gt;Selecciona una pestaña,&lt;br&gt;captura, carga y simula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="180" height="95" as="geometry"/></mxCell><mxCell id="tabs" value="&lt;b&gt;Nueva solicitud&lt;/b&gt;&lt;br&gt;Pestañas de proceso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="170" height="95" as="geometry"/></mxCell><mxCell id="softlandRead" value="&lt;b&gt;Softland — consultas previas&lt;/b&gt;&lt;br&gt;SELECT NIVEL_PRECIO + VERSION_NIVEL&lt;br&gt;SELECT ARTICULO + ARTICULO_PRECIO&lt;br&gt;Listas activas, precios, costos, margen y grupos" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="290" height="125" as="geometry"/></mxCell><mxCell id="tabGlobal" value="&lt;b&gt;Pestaña 1 — Gestión Global por Lista&lt;/b&gt;&lt;br&gt;Selecciona lista + Factor %&lt;br&gt;Simula todos los artículos de la lista&lt;br&gt;Valida precio, redondeo y margen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="290" height="110" as="geometry"/></mxCell><mxCell id="tabBase" value="&lt;b&gt;Pestaña 2 — Actualización Lista Base&lt;/b&gt;&lt;br&gt;Lista MAYOREOD + grupo + Factor %&lt;br&gt;Simula el grupo seleccionado&lt;br&gt;Exige confirmación de impacto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="290" height="110" as="geometry"/></mxCell><mxCell id="tabDiscount" value="&lt;b&gt;Pestaña 3 — Descuento por Artículo y Lista&lt;/b&gt;&lt;br&gt;Captura manual o Excel (.xlsx)&lt;br&gt;Valida artículo/lista/factor por fila&lt;br&gt;Muestra previsualización y errores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="290" height="115" as="geometry"/></mxCell><mxCell id="tabMargin" value="&lt;b&gt;Pestaña 4 — Margen de Utilidad Masivo&lt;/b&gt;&lt;br&gt;Excel: Código Artículo + % Reducción&lt;br&gt;Normaliza 10% → 0.10&lt;br&gt;Simula margen mínimo por fila" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="760" width="290" height="115" as="geometry"/></mxCell><mxCell id="portalInsert" value="&lt;b&gt;PORTAL_PRECIOS — registrar solicitud&lt;/b&gt;&lt;br&gt;INSERT SOLICITUD_PRECIO: PENDIENTE&lt;br&gt;INSERT SOLICITUD_PRECIO_DETALLE: filas simuladas&lt;br&gt;INSERT AUDITORIA_EVENTOS: SOLICITUD_ENVIADA&lt;br&gt;No modifica Softland" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="420" width="310" height="130" as="geometry"/></mxCell><mxCell id="approver" value="&lt;b&gt;Aprobador — Bandeja&lt;/b&gt;&lt;br&gt;Consulta solicitud y simulación&lt;br&gt;Valida ámbito, estado y segregación&lt;br&gt;No puede aprobar su propia solicitud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="420" width="260" height="115" as="geometry"/></mxCell><mxCell id="decision" value="&lt;b&gt;¿Aprobada?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1710" y="435" width="135" height="90" as="geometry"/></mxCell><mxCell id="reject" value="&lt;b&gt;Rechazo&lt;/b&gt;&lt;br&gt;UPDATE SOLICITUD_PRECIO: RECHAZADO + motivo&lt;br&gt;INSERT AUDITORIA_EVENTOS: SOLICITUD_RECHAZADA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1930" y="720" width="250" height="100" as="geometry"/></mxCell><mxCell id="enqueue" value="&lt;b&gt;Aprobación y encolado&lt;/b&gt;&lt;br&gt;UPDATE SOLICITUD_PRECIO: EN_PROCESO&lt;br&gt;Guarda aprobador + ID_PROCESO_SP&lt;br&gt;INSERT AUDITORIA_EVENTOS: EJECUCION_ENCOLADA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1930" y="420" width="250" height="115" as="geometry"/></mxCell><mxCell id="priceSp" value="&lt;b&gt;Para pestañas 1, 2 y 3&lt;/b&gt;&lt;br&gt;EXEC SP_GESTION_LISTAS_PRECIOS_CON_REDONDEO&lt;br&gt;Parámetros: lista destino/base, fechas, factor,&lt;br&gt;versión, usuario, filtros y redondeo&lt;br&gt;Actualiza ARTICULO_PRECIO.PRECIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1930" y="150" width="270" height="130" as="geometry"/></mxCell><mxCell id="marginUdf" value="&lt;b&gt;Para pestaña 4 — por artículo válido&lt;/b&gt;&lt;br&gt;MERGE / INSERT-UPDATE U_FACTOR_REDUCCION_MARGEN&lt;br&gt;U_CODIGO, U_DESCRIP, U_FACTOR_REDUCCION, U_ACTIVO&lt;br&gt;Guarda el porcentaje explícito: 10.00 = 10%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1930" y="910" width="270" height="120" as="geometry"/></mxCell><mxCell id="marginSp" value="&lt;b&gt;Después de la UDF — por artículo válido&lt;/b&gt;&lt;br&gt;EXEC SP_CALCULAR_MARGEN_MINIMO_ARTICULO&lt;br&gt;Parámetros: lista, versión, artículo, usuario&lt;br&gt;UPDATE ARTICULO_PRECIO.MARGEN_UTILIDAD_MIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1580" y="910" width="270" height="120" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;Resultado y auditoría&lt;/b&gt;&lt;br&gt;UPDATE SOLICITUD_PRECIO: PROCESADO / PROCESADO_CON_ERRORES / ERROR_EJECUCION&lt;br&gt;UPDATE detalle con resultado por fila&lt;br&gt;INSERT AUDITORIA_EVENTOS: EJECUCION_FINALIZADA" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="650" width="350" height="125" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Regla de operación&lt;/b&gt;&lt;br&gt;Antes de aprobar: SELECT Softland + INSERT Portal únicamente.&lt;br&gt;Después de aprobar: el worker autorizado ejecuta SP/UDF Softland.&lt;br&gt;Cada transición queda auditada en PORTAL_PRECIOS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="810" height="100" as="geometry"/></mxCell><mxCell id="e1" value="elige proceso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="operator" target="tabs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="consulta catálogos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabs" target="softlandRead"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Pestaña 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabs" target="tabGlobal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Pestaña 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabs" target="tabBase"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Pestaña 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabs" target="tabDiscount"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Pestaña 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabs" target="tabMargin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="enviar a aprobación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabGlobal" target="portalInsert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="enviar a aprobación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabBase" target="portalInsert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="enviar a aprobación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabDiscount" target="portalInsert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="enviar a aprobación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="tabMargin" target="portalInsert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="bandeja pendiente" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="portalInsert" target="approver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="decide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="approver" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="decision" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="decision" target="enqueue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="procesos de precio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="enqueue" target="priceSp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="margen masivo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="enqueue" target="marginUdf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="ejecuta SP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="marginUdf" target="marginSp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="priceSp" target="result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="marginSp" target="result"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>